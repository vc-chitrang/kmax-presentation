  engineCentre: {x: -0.49612764, y: 1.7854712, z: 0.2788057}
  engineAxis: {x: -0.000574571, y: 0.19777009, z: 0.9802483}
  elevatorAxis: {x: 1, y: 0, z: 0}
  liftArrow: {fileID: 6352943720421785470}
  weightArrow: {fileID: 6035908375244933513}
  thrustArrow: {fileID: 1889127661346876655}
  dragArrow: {fileID: 3052286394737726663}
  concepts:
  - label: Four forces
    caption: Four forces act on a plane. When they balance, it flies straight and
      level.
    formula: 'Lift = Weight

      Thrust = Drag'
    symbols: "Lift pushes up \xB7 weight pulls down \xB7 thrust pushes forward \xB7
      drag pulls back"
    explanation: Lift pushes the plane up and weight pulls it down. Thrust pushes
      it forward and drag holds it back. When each pair is equal, the plane keeps
      its height and its speed.
    windSpeed: 5
    circulation: 0.5
    slipstream: 0.4
    wake: 0
    propellerDegreesPerSecond: 700
    elevatorSwing: 0
    showLift: 1
    showWeight: 1
    showThrust: 1
    showDrag: 1
  - label: Lift from wings
    caption: Air runs faster over the curved top of the wing, and the wing is pushed
      up.
    formula: "Lift = \xBD \xB7 \u03C1 \xB7 v<sup>2</sup> \xB7 S \xB7 C<sub>L</sub>"
    symbols: "\u03C1 air density \xB7 v air speed \xB7 S wing area \xB7 C<sub>L</sub>
      how well the wing shape lifts"
    explanation: The wing is curved on top, so the air speeds up there and its pressure
      drops (the faster, whiter streaks). The slower air below pushes up. The wing
      also bends the air downward, and the air pushes the wing up in return.
    windSpeed: 6
    circulation: 1.1
    slipstream: 0
    wake: 0
    propellerDegreesPerSecond: 600
    elevatorSwing: 0
    showLift: 1
    showWeight: 1
    showThrust: 0
    showDrag: 0
  - label: Thrust
    caption: The propeller throws air backward, and the air pushes the plane forward.
    formula: "Thrust = m \xB7 ( v<sub>out</sub> \u2212 v<sub>in</sub> )"
    symbols: "m mass of air moved each second \xB7 v<sub>out</sub> air speed behind
      the propeller \xB7 v<sub>in</sub> air speed before it"
    explanation: A propeller is a spinning wing. It speeds up a stream of air and
      throws it backward. The air pushes the plane forward. In this Gnome engine
      the whole engine spins round with the propeller.
    windSpeed: 5
    circulation: 0.5
    slipstream: 1
    wake: 0
    propellerDegreesPerSecond: 2000
    elevatorSwing: 0
    showLift: 0
    showWeight: 0
    showThrust: 1
    showDrag: 1
  - label: Drag
    caption: Air resists everything that moves through it, and leaves swirls behind.
    formula: "Drag = \xBD \xB7 \u03C1 \xB7 v<sup>2</sup> \xB7 S \xB7 C<sub>D</sub>"
    symbols: "\u03C1 air density \xB7 v air speed \xB7 S front area \xB7 C<sub>D</sub>
      how streamlined the shape is"
    explanation: Wings, struts, wires and the pilot all push the air aside and make
      it swirl behind the plane. Double the speed and the drag is four times bigger,
      so engines work hard to go fast.
    windSpeed: 5
    circulation: 0.3
    slipstream: 0.3
    wake: 0.8
    propellerDegreesPerSecond: 700
    elevatorSwing: 0
    showLift: 0
    showWeight: 0
    showThrust: 1
    showDrag: 1
  - label: Steering
    caption: The front elevator tilts to point the nose up or down.
    formula: "Bigger angle \u2192 more lift"
    symbols: The elevator turns the whole plane, and that changes the angle at which
      the wings meet the air
    explanation: The pilot tilts the front elevator. Tilted up, it raises the nose,
      the wings meet the air at a bigger angle and give more lift. Tilted down, the
      nose drops and the plane sinks.
    windSpeed: 5
    circulation: 0.8
    slipstream: 0.3
    wake: 0
    propellerDegreesPerSecond: 700
    elevatorSwing: 14
    showLift: 0
    showWeight: 0
    showThrust: 0
    showDrag: 0
  flyController: {fileID: 0}
  choices: []
  previousButton: {fileID: 0}
  nextButton: {fileID: 0}
  subtitleText: {fileID: 0}
  counterText: {fileID: 0}
  captionNameText: {fileID: 0}
  captionBodyText: {fileID: 0}
  formulaText: {fileID: 0}
  symbolsText: {fileID: 0}
  explanationText: {fileID: 0}
  spinBlendSeconds: 0.8
  elevatorSwingSeconds: 3.2
