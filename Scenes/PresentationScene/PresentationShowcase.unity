  m_Name: 
  m_EditorClassIdentifier: KmaxPresentation::ViitorCloud.KmaxPresentation.PresentationDirector
  items:
  - title: Human Body
    subtitle: "Biology  \u2022  Whole-body atlas"
    description: A full human body built from separate systems, with the organs glowing
      in turn and the layers drawn apart.
    shortDescription: Every system of the body, layer by layer
    group: Biology
    prefab: {fileID: 4255595399543801196, guid: 38935776bd387804b90a6921641a2fc2, type: 3}
    show: 1
    fitSize: 0.72
    baseEuler: {x: 0, y: 0, z: 0}
    tiltDegrees: 3
    spinDegreesPerSecond: 26
    sway: 0
    swayDegrees: 32
    pulse: 0
    anatomyTopic: body
    scale: 1
  - title: Heart
    subtitle: "Biology  \u2022  The body's pump"
    description: The heart pushes blood around the body, beating about once every
      second at rest.
    shortDescription: Pumps blood around the body
    group: Biology
    prefab: {fileID: 8938092456628613654, guid: 8af334414a2b4e34088dec57b8d33587, type: 3}
    show: 0
    fitSize: 0.64
    baseEuler: {x: 0, y: 0, z: 0}
    tiltDegrees: 6
    spinDegreesPerSecond: 26
    sway: 0
    swayDegrees: 32
    pulse: 0
    anatomyTopic: heart
    scale: 1
  - title: Brain
    subtitle: "Biology  \u2022  Command centre"
    description: The brain controls movement, memory and thought through billions
      of connected nerve cells.
    shortDescription: Controls movement, memory and thought
    group: Biology
    prefab: {fileID: 1697903264189672190, guid: d2402f0aacbd0274eb6f81b3334a2be0, type: 3}
    show: 0
    fitSize: 0.64
    baseEuler: {x: 0, y: 0, z: 0}
    tiltDegrees: 10
    spinDegreesPerSecond: 26
    sway: 0
    swayDegrees: 32
    pulse: 1
    anatomyTopic: brain
    scale: 1
  - title: Ear
    subtitle: "Biology  \u2022  Hearing and balance"
    description: The ear turns sound waves into nerve signals and helps the body
      keep its balance.
    shortDescription: Turns sound into signals, keeps balance
    group: Biology
    prefab: {fileID: 41524841920412318, guid: 1c58a342c085f3a4eba01091851194e0, type: 3}
    show: 0
    fitSize: 0.64
    baseEuler: {x: 0, y: 0, z: 0}
    tiltDegrees: 6
    spinDegreesPerSecond: 26
    sway: 0
    swayDegrees: 32
    pulse: 0
    anatomyTopic: ear
    scale: 1
  - title: Eye
    subtitle: "Biology  \u2022  How we see"
    description: The eye focuses light onto the retina, which sends the picture to
      the brain.
    shortDescription: Focuses light into the picture we see
    group: Biology
    prefab: {fileID: 8197536783087976363, guid: 824278bc67281b8478a5516fdfd549c9, type: 3}
    show: 0
    fitSize: 0.64
    baseEuler: {x: 0, y: 0, z: 0}
    tiltDegrees: 4
    spinDegreesPerSecond: 26
    sway: 0
    swayDegrees: 32
    pulse: 0
    anatomyTopic: eye
    scale: 1
  - title: Breathing
    subtitle: "Biology  \u2022  Lungs and airways"
    description: Air travels down the windpipe into the lungs, where oxygen passes
      into the blood.
    shortDescription: Air travels in, oxygen enters the blood
    group: Biology
    prefab: {fileID: 4898606538655779972, guid: 0c2df706100278a469a5c554fac5ad30, type: 3}
    show: 0
    fitSize: 0.78
    baseEuler: {x: 0, y: 0, z: 0}
    tiltDegrees: 4
