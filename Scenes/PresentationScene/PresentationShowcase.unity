    sway: 0
    swayDegrees: 32
    pulse: 0
    anatomyTopic: breathing
    scale: 1
  - title: Skull
    subtitle: "Biology  \u2022  Head protection"
    description: The skull shields the brain and gives the face its shape; the jaw
      opens and closes on its hinge.
    shortDescription: Protects the brain, shapes the face
    group: Biology
    prefab: {fileID: 808839450474288565, guid: 33c0c954ff27400428dca01a085160d7, type: 3}
