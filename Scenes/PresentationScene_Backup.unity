    sway: 0
    swayDegrees: 32
    pulse: 0
    anatomyTopic: body
    positionOffset: {x: 0, y: 0, z: 0}
    scaleMultiplier: 1
    topBottomPadding: 0.2
  - title: Heart
    subtitle: "Biology  \u2022  The body's pump"
    description: The heart pushes blood around the body, beating about once every
      second at rest.
