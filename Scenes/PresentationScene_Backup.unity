  items:
  - title: Human Body
    subtitle: "Biology  \u2022  Whole-body atlas"
    description: A full human body built from separate systems, with the organs glowing
      in turn and the layers drawn apart.
    group: Biology
    prefab: {fileID: 4255595399543801196, guid: 38935776bd387804b90a6921641a2fc2, type: 3}
    show: 1
